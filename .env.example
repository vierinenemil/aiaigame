OPENROUTER_API_KEY=sk-or-...
VERCEL_BLOB_TOKEN=
APP_REFERER=http://localhost:3000
APP_TITLE=AI Time-Travel Explorer
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_VIDEO_PLACEHOLDER=true
STARTER_IMAGE_PATH=

# Core world model
WORLD_MODEL=x-ai/grok-3-mini
SCENE_OBSERVER_MODEL=x-ai/grok-3-mini

# Video master switch
ENABLE_VIDEO_GENERATION=true

# Image-to-video preferred provider
VIDEO_PROVIDER=replicate_wan_i2v_fast

# Provider keys
REPLICATE_API_TOKEN=
FAL_KEY=

# Cinematic defaults
VIDEO_WIDTH=832
VIDEO_HEIGHT=480
VIDEO_SECONDS=4
VIDEO_FPS=16
IDLE_LOOP_SECONDS=1
VIDEO_AUDIO=false

# Product cadence
VIDEO_MAJOR_MOMENTS_ONLY=false
VIDEO_EVERY_N_TURNS=1
VIDEO_MAX_PER_SESSION=10
VIDEO_MAX_SESSION_SPEND_USD=0.60

# Cache
VIDEO_CACHE_DIR=.cache/videos
